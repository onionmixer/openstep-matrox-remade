/*
 * R6 PCI matching table for the replacement display driver.  Modeled on the
 * production MatroxMGA (per-board .table): "Memory Maps", "I/O Ports" and
 * "FB Address" are EMPTY so the driver reserves no legacy resources that could
 * conflict with the boot console; it reads BAR0 (framebuffer) and BAR1 (MMIO)
 * from PCI config and maps them with IOMapPhysicalIntoIOTask.  "Auto Detect
 * IDs" 0x0525102B = Matrox 102b:0525 (MGA G400/G450), deviceID<<16 | vendorID.
 *
 * "Storm 2D Test" and "VRAM Mmap" are development switches, default "No":
 *   Storm 2D Test -- run the engine self-tests at the end of enterLinearMode.
 *                    With "No" a normal boot writes no drawing-engine register.
 *   DMA Ring Test -- D1 primary-DMA bring-up (docs/D1_PRIMARY_DMA_RING_PLAN.md).
 *                    D1-0 only allocates 64 KiB of the conventional-memory
 *                    arena and measures it; no engine register is written.
 *   WARP Test     -- D2 WARP configuration probe; writes two registers and
 *                    reads one back, draws nothing.
 *   VRAM Mmap     -- publish the offscreen VRAM window as a character device.
 *                    Once enabled the driver must not be unloaded, because
 *                    client mappings outlive it (docs/S4A_VRAM_MMAP_PLAN.md).
 */
"Title" = "OpenStep MGA Replacement Display";
"Family" = "Display";
"Version" = "0.5";
"Location" = "";
"Instance" = "0";
"Driver Name" = "OpenStepMGAReplacementDisplay";
"Class Names" = "OpenStepMGAReplacementDisplay";
"Server Name" = "OpenStepMGAReplacementDisplay";
"Bus Type" = "PCI";
"Auto Detect IDs" = "0x0525102B";
"Display Mode" = "Height: 768 Width: 1024 Refresh: 60Hz ColorSpace: RGB:888/32";
"MGA Memory Size" = "16";
"Storm 2D Test" = "No";
"VRAM Mmap" = "No";
"DMA Ring Test" = "No";
"WARP Test" = "No";
"FB Address" = "";
"Memory Maps" = "";
"VGA Memory Maps" = "0xa0000-0xbffff 0xc0000-0xcffff";
"I/O Ports" = "";
"DMA Channels" = "";
"IRQ Levels" = "";
