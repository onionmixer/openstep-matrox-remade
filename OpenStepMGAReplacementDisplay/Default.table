/*
 * R6 PCI matching table for the replacement display driver.  Modeled on the
 * production MatroxMGA (per-board .table): "Memory Maps", "I/O Ports" and
 * "FB Address" are EMPTY so the driver reserves no legacy resources that could
 * conflict with the boot console; it reads BAR0 (framebuffer) and BAR1 (MMIO)
 * from PCI config and maps them with IOMapPhysicalIntoIOTask.  "Auto Detect
 * IDs" 0x0525102B = Matrox 102b:0525 (MGA G400/G450), deviceID<<16 | vendorID.
 */
"Title" = "OpenStep MGA Replacement Display";
"Family" = "Display";
