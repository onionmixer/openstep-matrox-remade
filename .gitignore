# Internal only.  HANDOFF.md carries the machine's real address and account
# details, so it stays out of the repository -- the workspace .gitignore
# already excludes it, but that file is not part of this project and a
# standalone clone would start tracking it again.
HANDOFF.md

# Proprietary / third-party analysis inputs must never be committed.
reference/original-binaries/*.i64
reference/original-binaries/*.idb
reference/original-binaries/*.id0
reference/original-binaries/*.id1
reference/original-binaries/*.nam
reference/original-binaries/*.til
ref/private/
ref/MatroxMGA-*.tgz
ref/*.i64
ref/*.idb
ref/*.id0
ref/*.id1
ref/*.nam
ref/*.til
analysis-output/

# OPENSTEP build products
build/
*.config/
i386_obj/
sym/
*.o
*.d
*.reloc

# Built libraries, kept only so a reboot does not cost a rebuild.
build/mesa/
scratch-cov/
scratch-att/
build/blend/

# Release artefacts.  pkg/collect-release-pkgs.sh writes build/release-pkgs on
# the target and pkg/make-release-assets.sh turns it into release-assets here;
# both are rebuildable from the repository and the second is 4.4 MB of
# binaries.  They belong on a release page, not in history.
release-assets/
scratchpad/
