#!/bin/csh -f
# i386 only, for the same reason as the driver: the archive is i386 machine
# code.  The relocatable prefix is the caller's to choose, so unlike the
# recovery staging package this one places no restriction on it.

if ($#argv != 2) then
    echo "FAILED (unexpected Installer arguments)"
    exit 1
endif

set cpu = `/usr/bin/arch`
if ("$cpu" != "i386") then
    echo "OpenStepMGAMesaAccel installs only on Intel i386/i486 computers."
    exit 1
endif

exit 0
